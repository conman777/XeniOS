<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="jp.xenios.emulator.LauncherActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/launcher_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_status_missing_game"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            android:id="@+id/debug_checkpoint_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFF3E0"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkpoint_debug_banner"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/checkpoint_launcher_instructions" />

            <TextView
                android:id="@+id/checkpoint_snapshot_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/checkpoint_autosave_missing" />

            <Button
                android:id="@+id/create_checkpoint_snapshot_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:onClick="onCreateCheckpointSnapshotClick"
                android:text="@string/checkpoint_create_button" />

            <Button
                android:id="@+id/restore_checkpoint_snapshot_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:onClick="onRestoreCheckpointSnapshotClick"
                android:text="@string/checkpoint_restore_button" />

        </LinearLayout>

        <TextView
            android:id="@+id/launcher_game_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/launch_game_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:onClick="onLaunchDetectedGameClick"
            android:text="@string/activity_label_emulator" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onClick="onPickGameClick"
            android:text="@string/launcher_button_pick_game" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onClick="onRescanGamesClick"
            android:text="@string/launcher_button_rescan" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="onLaunchGpuTraceViewerClick"
            android:text="@string/activity_label_gpu_trace_viewer" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onClick="onLaunchWindowDemoClick"
            android:text="@string/activity_label_window_demo" />

    </LinearLayout>

</ScrollView>
