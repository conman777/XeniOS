#include "pixel_formats.xesli"
#include "texture_load.xesli"

// Keep both sides scalar for the Adreno diagnostic path. The normal texture
// load entry declares the destination as uint4[], so even scalar source reads
// still become 16-byte SSBO stores.
byte_buffer_align4_wo_declare_xe(xe_texture_load_dest, set=0, binding=0, u0,
                                 space0)
byte_buffer_align4_declare_xe(xe_texture_load_source, set=1, binding=0, t0,
                              space0)

void StoreRGBA16UNormPixelScalar(const XeTextureLoadInfo load_info,
                                 const uint3_xe block_index,
                                 const uint block_offset_host) {
  uint2_xe guest_words = byte_buffer_align4_load8u_xe(
      xe_texture_load_source,
      XeTextureLoadSourceAddressUnsigned2D(load_info, block_index, 3u));
  guest_words = XeEndianSwap32(guest_words, load_info.endian_32);

  float4_xe value =
      float4_xe(guest_words.x & 0xFFFFu, guest_words.x >> 16u,
                guest_words.y & 0xFFFFu, guest_words.y >> 16u) *
      (1.0f / 65535.0f);
  byte_buffer_align4_store4_xe(
      xe_texture_load_dest, block_offset_host,
      pack_half_2x16_xe(value.xy));
  byte_buffer_align4_store4_xe(
      xe_texture_load_dest, block_offset_host + 4u,
      pack_half_2x16_xe(value.zw));
}

entry_bindings_begin_compute_xe
  XE_TEXTURE_LOAD_PUSH_CONST_BINDING
  entry_binding_next_xe
  byte_buffer_wo_binding_xe(xe_texture_load_dest, buffer(1))
  entry_binding_next_xe
  byte_buffer_binding_xe(xe_texture_load_source, buffer(2))
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
{
  // Four guest pixels are still handled per invocation so dispatch and host
  // layout match the normal RGBA16 load pipeline.
  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(2u, 0u, 0u);
  dont_flatten_xe
  if (any(greater_than_equal_xe(block_index.xy, load_info.size_blocks.xy))) {
    return;
  }

  uint block_offset_host =
      load_info.host_offset +
      uint(XeTextureHostLinearOffset(int3_xe(block_index), load_info.host_pitch,
                                     load_info.size_blocks.y, 8u));

  StoreRGBA16UNormPixelScalar(load_info, block_index, block_offset_host);
  StoreRGBA16UNormPixelScalar(load_info,
                              block_index + uint3_xe(1u, 0u, 0u),
                              block_offset_host + 8u);
  StoreRGBA16UNormPixelScalar(load_info,
                              block_index + uint3_xe(2u, 0u, 0u),
                              block_offset_host + 16u);
  StoreRGBA16UNormPixelScalar(load_info,
                              block_index + uint3_xe(3u, 0u, 0u),
                              block_offset_host + 24u);
}
entry_code_end_compute_xe
