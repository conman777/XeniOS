#include "texture_load.xesli"

byte_buffer_align4_wo_declare_xe(xe_texture_load_dest, set=0, binding=0, u0,
                                 space0)
byte_buffer_align4_declare_xe(xe_texture_load_source, set=1, binding=0, t0,
                              space0)

void Store32bpbPatternPixel(const XeTextureLoadInfo load_info,
                            const uint3_xe block_index,
                            const uint block_offset_host) {
  uint value;
  dont_flatten_xe if (load_info.diagnostic_pattern) {
    uint r = ((block_index.x * 255u) /
              max(load_info.size_blocks.x - 1u, 1u)) & 0xFFu;
    uint g = ((block_index.y * 255u) /
              max(load_info.size_blocks.y - 1u, 1u)) & 0xFFu;
    uint b = ((((block_index.x >> 5u) ^ (block_index.y >> 5u)) & 1u) *
              255u);
    value = r | (g << 8u) | (b << 16u) | 0xFF000000u;
  } else {
    value = byte_buffer_align4_load4_xe(
        xe_texture_load_source,
        XeTextureLoadSourceAddress(load_info, block_index, 2u));
    value = XeEndianSwap32(value, load_info.endian_32);
  }
  byte_buffer_align4_store4_xe(xe_texture_load_dest, block_offset_host, value);
}

entry_bindings_begin_compute_xe
  XE_TEXTURE_LOAD_PUSH_CONST_BINDING
  entry_binding_next_xe
  byte_buffer_wo_binding_xe(xe_texture_load_dest, buffer(1))
  entry_binding_next_xe
  byte_buffer_binding_xe(xe_texture_load_source, buffer(2))
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
{
  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(3u, 0u, 0u);
  dont_flatten_xe
  if (any(greater_than_equal_xe(block_index.xy, load_info.size_blocks.xy))) {
    return;
  }

  uint block_offset_host =
      load_info.host_offset +
      uint(XeTextureHostLinearOffset(int3_xe(block_index), load_info.host_pitch,
                                     load_info.size_blocks.y, 4u));
  Store32bpbPatternPixel(load_info, block_index, block_offset_host);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(1u, 0u, 0u),
                         block_offset_host + 4u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(2u, 0u, 0u),
                         block_offset_host + 8u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(3u, 0u, 0u),
                         block_offset_host + 12u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(4u, 0u, 0u),
                         block_offset_host + 16u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(5u, 0u, 0u),
                         block_offset_host + 20u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(6u, 0u, 0u),
                         block_offset_host + 24u);
  Store32bpbPatternPixel(load_info, block_index + uint3_xe(7u, 0u, 0u),
                         block_offset_host + 28u);
}
entry_code_end_compute_xe
